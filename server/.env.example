# ──────────────────────────────────────────────────────────
# LeafSense Server — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────────

# ── MongoDB Atlas ──────────────────────────────────────────
# From: cloud.mongodb.com → Connect → Drivers
# Replace <username>, <password>, and <cluster> with your values
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/leafsense?retryWrites=true&w=majority

# ── JWT ────────────────────────────────────────────────────
# Any long random string — used to sign tokens
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ── Server ─────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Frontend URL (for redirect after OAuth) ────────────────
CLIENT_URL=http://localhost:5173
