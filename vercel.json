{
  "rewrites": [
    {
      "source": "/api/vision/:path*",
      "destination": "https://leafsense-vision-ai.onrender.com/api/vision/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://leafsense-node-api.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://leafsense-node-api.onrender.com/auth/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
